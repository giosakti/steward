# Copy to .env and adjust these local examples. Existing environment variables take precedence.
DATABASE_URL=postgresql://steward:steward@127.0.0.1:5432/steward
# Tests use a separate database and temporary schemas within it.
TEST_DATABASE_URL=postgresql://steward:steward@127.0.0.1:5432/steward_test
# Local human-operator API token. Generate with: openssl rand -hex 32
# Do not share this token with agents.
STEWARD_API_TOKEN=
PORT=3000
# CLI connection (the CLI does not use DATABASE_URL).
STEWARD_API_URL=http://127.0.0.1:3000
# Optional local selection file; otherwise uses $XDG_CONFIG_HOME/steward/config.json
# or ~/.config/steward/config.json. No credentials are stored in this file.
# STEWARD_CONFIG_FILE=/path/to/config.json
# Server-only Jev credential; missing credentials make decisions escalate.
TYPESAFE_API_KEY=
