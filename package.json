{
  "name": "steward",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-migrations.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --env-file-if-exists=.env --test dist/tests/*.test.js",
    "steward": "node dist/src/cli/main.js",
    "db:migrate": "npm run steward -- init",
    "lint": "eslint . --max-warnings 0"
  },
  "dependencies": {
    "commander": "15.0.0",
    "node-pg-migrate": "9.0.0",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.5",
    "@types/pg": "8.23.1",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0"
  }
}
