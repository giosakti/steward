{
  "name": "steward",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --env-file-if-exists=.env --test dist/tests/*.test.js",
    "db:migrate": "node --env-file-if-exists=.env node_modules/node-pg-migrate/bin/node-pg-migrate.js up --migrations-dir src/storage/migrations --advisory-lock-mode wait --no-verbose",
    "lint": "eslint . --max-warnings 0",
    "steward": "node --env-file-if-exists=.env dist/src/cli/main.js"
  },
  "dependencies": {
    "commander": "15.0.0",
    "kysely": "0.29.6",
    "node-pg-migrate": "9.0.0",
    "pg": "8.23.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.5",
    "@types/pg": "8.23.1",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0"
  }
}
